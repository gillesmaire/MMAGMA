// Stompin At The Savoy  (Benny Goodman, 1936)

Tempo 130
KeySig  F

Groove Metronome2-4
  z * 2
  
Groove SwingIntro

Begin AllGrooves
    Begin Arpeggio
        Voice JazzGuitar
        Octave 5
        Articulate 110
        Harmony 3Below
        Volume mf
        Rskip 60
    End
End

// These changes only apply to the intro
Begin Chord-Guitar
   Voice NylonGuitar
   Volume mf
   Articulate 110
End

Swell mp mf 4

1         F
2        Dm
3        Gm
4        C7


Repeat  /// this for entire song
Repeat  /// for A section

Groove Swing1
Volume m

5         F
6         /      /     C9
7         F
8         /      / F#dim7

Groove Swing1Plus
Cresc f 2

9       Gm7
10       C9

RepeatEnding

11        F      / Abdim7
12      Gm7      /     C9

RepeatEnd

13        F
14      Cm7      /     F7

Groove Swing1Sus
Volume m

15      Bb7      /     B7
16      Bb7
17      Eb9      / Bbm7b5
18      Eb9

Groove Swing1PlusSus
Cresc mf 2

19      Ab7      /     A7
20      Ab7
21      Db7
22       C7      /     C9

Groove Swing1
Volume m

23        F
24        /      /     C9
25        F
26        /      / F#dim7

Groove Swing1Plus
Decresc mp 2

27      Gm7
28       C9

RepeatEnding

29        F      /    Eb9     E9
30      FM9      /    C7

Repeatend

Groove Swing1End
Decresc ppp 2

29       F
30       /   z!
