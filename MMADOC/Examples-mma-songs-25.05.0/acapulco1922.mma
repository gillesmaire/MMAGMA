// Acapulco 1922 (Herb Alpert, 1962)

Tempo 142
KeySig F

Groove Metronome2-4
   z * 2
   
Groove SwingIntro

Begin Solo
    Voice Trumpet
    Octave 5
    Harmony OpenBelow+8Below
    Rtime 4
    Articulate 90
    Volume f
    Begin Riff
        4r;2f+;4d+;
        4c+;a;8.g;16f;8d;1f~;
        1r;
        8.f;16d;8f;4.a;4c+;
    End
End

Swell mp mf 4

1        Bb
2         C      /     Am
3         F
4        C7

Repeat   // for the DS/Coda
Repeat

Groove Swing
Volume m

5         F
6         F
7        Dm
8        Dm

Groove SwingPlus
Volume mf

9        Bb
10       Gm
11       C7      /    Gm7
12       C7

Groove Swing
Cresc f 2

13       Bb
14       C7

RepeatEnding

Groove SwingFill
Volume m

15        F      /     Bb
16       Am    Abm    Gm7     C7

RepeatEnd

Decresc mp 2

17        F      /    Bb7
18        F

Groove SwingSus
Volume m

19       Bb
20       Bb
21        F
22        /

Groove SwingPlusSus
Volume f

23       G7
24       G7
25        C
26       C7

Groove Swing
Decresc m 4

27        F
28        F
29       Dm
30        /

Groove SwingPlus

31       Bb
32       Gm
33       C7      /    Gm7
34       C7

Groove Swing
Decresc mp 2

35       Bb
36       C7

RepeatEnding    // Changed from a "to Coda"

Groove SwingFill

37        F
38        F      /    Gm7     C7

RepeatEnd   // Coda section
Decresc pp 4

39        F      /    Bb7
40        F      /    Bb7

Groove SwingEnd

41        /
42        / / / z!

