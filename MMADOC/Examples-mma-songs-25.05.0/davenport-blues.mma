// Davenport Blues (Beiderbecke, 1925)

Tempo 100
Keysig Eb

Groove Metronome2-4
   z * 2
   
Groove SwingIntro

Begin Solo
    Voice Jazzguitar
    Volume mp
    Octave 5
    Articulate 80
    Harmony OpenBelow
    Begin Riff
        8g;b;c+;d&+;4c+;4+4b ~;
        ~ 4r;8d+;c+;b;a;
        8f;a;f;a; 4f;a;
        2.b;4r;
    End
End

Begin Solo-2
    Voice VoiceOohs
    Volume ff 
   Octave 5
    Articulate 90
    DupRiff From Solo
End

