// My Hats On The Side Of My Head (1933)

Tempo 130
Keysig C
Transpose up per 4  // transpose to F

Groove Metronome2-4
   z * 2
   
Groove FoxTrotIntro

Begin Solo
    Voice Whistle
    Octave 6
    Swell ppp mp 4
    Articulate 90
    Harmony 8Below+Open8Below
    Rtime 10
    Rvolume 10
    Begin Riff
       4c+;;;g;
       4a;;2;
       8.g;16a;8.g;16c;4e;f;
       1g;
    End
End

1          C
2         Am
3          C
4         G7

Repeat
Groove FoxTrot
Volume m

5          C
6         C7
7          F
8         Fm

Groove FoxTrotPlus
Cresc f 4

9          F      /   Cdim
10         C   Fdim     Am
11       Am7      /     G7
12         C      /     G7

Groove FoxTrot
Volume mf

13         C
14        C7
15         F
16       Fm7

Groove FoxTrotPlus
Cresc f 4

17         F      /   Cdim
18         C   Fdim     Am
19       Am7      /     G7
20         C

Groove FoxTrotSus
Volume m

21        C7
22         /
23         F
24         /

Groove FoxTrotSusPlus
Volume mf

25       Am7
26        D7
27        G7
28         /   Gdim      G

Groove FoxTrotSus
Decresc mp 4

29         C
30        C7
31         F
32        Fm

Groove FoxTrot
Volume m

33         F      /   Fdim
34         C   Fdim     Am     Fm

If def FINE
   Groove FoxTrotEnd
   Decresc pppp 2
Else
   Groove FoxTrotFill
Endif

35         C   Cdim     G7
36         C

Set FINE   // 2nd time we'll do the 'ending' groove

RepeatEnd


