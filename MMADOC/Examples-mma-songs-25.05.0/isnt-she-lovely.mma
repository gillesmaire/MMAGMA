// Isn't She Lovely (Stevie Wonder, 1976)

Tempo 118
Keysig E

Transpose Down Aug 1  /// let's do it in Eb (we don't play none of them guitars!)

Groove Metronome2-4
  z * 2

Begin Solo
    Voice CleanGuitar
    Articulate 60
    Octave 5
    Volume FF
    Harmony 3Below
End

Groove LFusionIntroSus

Repeat
Cresc pp m 4
1      C#m7   {4g;;3r;6g;4;}
2       F#9   {4g;;3r;6g;4;}
3       B11   {4f;;3r;6f;4;}

RepeatEnding

4         E {4e;;3r;6e;4;}

RepeatEnd

5         E  {2e;}

Repeat
Groove LFusion
Volume mp

6      C#m7
7       F#9
8       B11
9         E

Groove LFusionSus
Cresc m 4

10     C#m7
11      F#9
12      B11
13        E

Groove LFusion
Volume mp

14      AM7
15    G#7b9      /    G#7
16     C#m7
17      F#9

Groove LFusionSus
Decresc p 2

18      B11
19        /

RepeatEnding 2

20        E

RepeatEnd
Groove LFusionEnd

20        E / z!

