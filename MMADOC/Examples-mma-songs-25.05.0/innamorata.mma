// Innamorata (Sweetheart, 1955)

Tempo 80
Keysig Bb

Groove Metronome3
  z * 2
  
Groove JazzWaltzIntro

// This should only effect JazzWaltz2. But, careful,
// the jazzwaltz1 also uses the Arpeggio track!
Allgrooves Arpeggio Harmony OpenAbove

Begin Solo
    Voice Piano1
    Volume f
    Harmony 3Below
    Articulate 105
    Octave 5
    Begin Riff
        4.b;8;;;
        4.d+;8;;;
        4.c+;8;;;
        2.f+;
    End
End

Swell mp mf 4

