// Ahora Seremos Felices
//  Rafael Hernandem 1938

Tempo 120
Keysig Eb

Groove Metronome2-4
   z * 2
   
Groove MamboIntro

Begin Solo
    Voice Vibraphone
    Volume ff
    Harmony OpenBelow
    Articulate 60
    Octave 5
    Begin Riff
        8e+;;;; ;;;;
        4e+;8d&+;8+2c+;
        8c+;;;; ;;;;
        1b;
    End
End

Swell m mf 4

1         Eb
2         Cm
3         Fm
4        Bb7

Label Sign
Groove Mambo
Volume m

5         Eb
6        Bb7
7          /
8         Eb

Groove Mambo3
Cresc mf 4

9          /
10        Ab
11        Bb
12       Eb6

Groove Mambo
Decresc mp 3

13        Eb
14       Bb7
15         /
16        Eb

Groove MamboSus
Cresc m 4

17         /
18        Ab
19       Bb7
20        Eb

Groove Mambo3Sus

21         /
22       Bb7
23         /
24        Eb

Groove Mambo
Cresc mf 2

25         /
26       Bb7
27         /
28        Eb

Groove Mambo1
Volume m

29       Eb7
30        Ab
31       Abm
32        Eb

Groove Mambo1Sus

Swell f 8

if def DS
  Decresc pppp 8
endif

Repeat

33        Eb
34       Bb7

if def FINE
  Groove MamboEnd
endif

35         /

RepeatEnding

36        Eb

if def DS
  set FINE
endif

RepeatEnd

37        Eb

If Ndef DS
  Set DS
  Goto Sign
Endif


