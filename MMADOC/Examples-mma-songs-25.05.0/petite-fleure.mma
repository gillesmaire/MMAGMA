// Petite Fleure (Sidney Bechet, 1952)

Keysig G minor
Tempo 110

Groove Metronome2-4
 z * 2

Groove NiteJazzPlus
    Begin Arpeggio-Guitar
        Sequence { A2; $Push2 8 70; $Push3 8 70} \
              { A1; $Push3 4 70 } \
              { A1; $Push2 8. 70 } \
              { A1; A4 Shift $Push0 }
        Volume mf
        Octave 6
        Articulate 100
   End
DefGroove NiteJazzPlus

Groove NiteJazzPlus
    Begin Chord-Sus
        Groove NiteJazzSus
        Voice Strings
        Volume mp
        Octave 6
    End
DefGroove NiteJazzSus

Groove NiteJazzIntro


Begin Solo
    Voice JazzGuitar
    Harmony 3Below+3Above+8Below
    Articulate 100
    Octave 5
    Volume ff
    //Arpeggiate Direction=Down Rate=4 Decay=-4
    Begin Riff
       2b;a;
       2.g;8g;;
       4f;;e;1d~;
    End
End

Decresc m p 1
