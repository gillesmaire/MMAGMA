// Make the arpeggios a bit less "in your face"
// shift the octaves due to the transpose 
Groove GuitarBallad
Begin AllGrooves
   Begin Arpeggio-4
        Articulate 120
        Octave  4
   End
   Begin Arpeggio-8
        Articulate 110
        Octave  4
   End
End

Repeat
