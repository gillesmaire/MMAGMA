// Maria Bonita
//    Agustin Lara, 1946

Tempo 180
Keysig F

Groove Metronome3
  z * 2
  
// Note, the latinwaltz groove has a time of 3,
//  and this song is notated in 6/8. So, we have
//  split each bar in 2. That is why only alternate
//  bars are numbered.

Groove LatinWaltzIntro8

// Just for the "plus" version, a bit less guitar
Begin AllGrooves Arpeggio
    Rskip 44
    Harmony 3Above
End

Begin Solo
    Voice JazzGuitar
    Volume f
    Articulate 90
    Octave 5
    Harmony OpenAbove
    Begin Riff
        4f;2+4~;
        ~ 4g;f;
        4a;2+4~;
        ~ 4b;a;
        4d+;2+4~;
        ~ 4b;a;
        2.c+;
    End
End

// To add to the 6/8 feeling (YES! we should write a new groove,
//   but I'm lazy and, besides, this is a good demo!) we add a
//   negative accent to every other bar AND we add a triangle hit
//   to the alternate bars as well


// Here's the triangle hit on bars 1,3,5,etc.
// Since we've already split the song into 2-bar chunks,
// this works as a sticky track. If we had "partial" bars
// we'd need to do more work.

Begin Drum-Solo-Triangle
     Sticky On
     Tone OpenTriangle
     Volume m
     Sequence D1 z
End


Begin After Repeat=2   // This "AFTER" is done on bars 3,5,7...
   Bass Accent    /// no accent
   Walk Accent
End

Swell mp f 8

1        F

Begin After Repeat=2   // And this is done on bars 2,4,6
   Bass Accent 1 -40
   Walk Accent 1 -40
End

         /
2        Dm
         /
3        Gm
         /
4        C7
         /


Repeat
Label Sign
Groove LatinWaltz
Volume m

5     Fadd9
        /
6       FM9
        /
7       F
        /
8       /
      Abdim
9       Gm7
         /
10       C
         /

Groove LatinWaltzSus
Cresc f 8

11       /
         /
12      Gm7
         /
13       C7
         /
14      Gm7
       C7#5
15       F
        Dm7
16      Gm9
        C11

Groove LatinWaltzSusPlus
Decresc m 8

17        F
         Gm7
18       Am7
         Gm9
19       FM7
         /
20      Cm7
        F7
21     BbM7
         /
22       /
         /

Groove LatinWaltzSus
Volume mf

23       Bb
       Bdim
24      F/C
         /

Groove LatinWaltz
Decresc m 2

25        F
          /
26      Gm7
          /
27       C7
          /

If Def DS
  Goto Coda
Endif

28        /
          /

RepeatEnding

29        F
        Dm7

Groove LatinWaltzFill
Volume mp

30      Gm7
        C11

RepeatEnd

31        F
          /

Groove LatinWaltz

32       Bb
         C7

Groove LatinWaltzSus
Cresc mf 2

33        F
          /
34       Bb
         C7
Decresc mp 2
35        F
          /

Groove LatinWaltzFill

36       Gm7
         C7

Set DS
Goto Sign

Label Coda

37       C7
         Dm7
         
Groove LatinWaltzSus
Volume m

38        F
         Dm7
39       Gm7
         C11
40        F
         Dm7
41       Gm7
         C11

Decresc ppp 4

42        F
          /

Groove LatinWaltzEnd

43        /
          /  z!


