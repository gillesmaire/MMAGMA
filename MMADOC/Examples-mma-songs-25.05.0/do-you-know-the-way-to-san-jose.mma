// Do You Know The Way To San Jose (Dionne Warwick, 1968)

Tempo 130
Keysig F

Groove Metronome2-4
    z * 2
    
Groove PopBalladIntro

/// Change the bass line in ALL the tracks
Begin AllGrooves NoWarn=True Bass
    Voice SlapBass1
    Volume ffff
    Articulate 85
    Octave 3
    Sequence B11
End

Begin Solo-Bass
    Voice $_Bass_Voice
    Volume f
    Articulate 80
    Octave 3
End
Begin Solo-Voice
    Voice VoiceOohs
    Articulate 110
    Harmony OpenBelow
    Octave 4
    Volume mf
End

//Replace the bass line with a solo version
Bass Sequence -

Begin Solo-Bass Riff
    4f;r;f;
    4f;r;f;8r;f;
    4f;8r;f;4;
    4f;8r;f;4f;
End

//Replace the bass line with a solo version
Bass Sequence -

Cresc mp ff 4
AutoSoloTracks Solo-Voice

1         F
2         /
3         /   { 4a+;g+;8f+;4e+;d+~;}
4         /   { ~ 4c+;8b;4a;g; }

AutoSoloTracks Solo-Bass

Repeat
Groove PopBallad
Volume m

