// Fernando (ABBA, 1976)

Tempo 102
Keysig A
Transpose Down Maj 3  // to 'F'

Groove Metronome2-4
  z * 2

/// One way to handle a DS al CODA. In this case we jump here,
/// BEFORE setting up the repeat. Normally, we would repeat too many
/// times ... but the RptCount variable saves us. We set it to 1 here
/// and before the jump (at bar 40) we set it to 0.

Set RptCount 1
Label SIGN   // to jump via DS

Repeat
Groove BossaNova

1         A
2         A/C#
3         A/E
4         A/C#

Groove BossanovaPlus

5       F#m
6         /
7        Bm
8        Bm/F#

Groove BossaNova2Sus

9         Bm
10        E/B
11        E

RepeatEnding $RptCount NoWarn

Truncate 2
12        E/G#
13        A

RepeatEnd
Truncate 2
14        /
15        A/C#

Groove BossaNovaSusPlus

16        A
17       E7
18        /
19        A

20        /
21       E7
22        /
23        A

24      A7/G  /// score says A/G
25       F#
26       B7
27        /

28       E7
29        /
30        A

If Def TOCODA
  Goto Coda
Endif

31        /
32       E7
33        /

Begin Solo 
     Voice JazzGuitar
     Volume ff
     Articulate 110
     Harmony OpenBelow+8Below
     Octave 5
End

34        D   {8r;4.a+;4f+;8g+;8+2a+~;}

35        /   {~ 4a+; 8b+;8+2.a+ ~; }
36        A   {~ 4e+;}

Truncate 2
37        /   {43c++;d++;c++;}

38       E7   {8b+;a+;;f+;;f+;;e+;}
39        /   {8e+;d+;;c+;;b;;a;}
40        A   {8e;c;e;c;e;c;e;c;}

Set TOCODA
Set RptCount 0 
Goto SIGN
Label CODA


Decresc mp pppp 8
Groove BossaNova2End
Repeat
41        A
42       E7
43        /
44        A
RepeatEnd


