// Some Of These Days (Sophie Tucker, 1910)

Tempo $(2 * 95)

KeySig D min

Groove Metronome2-4
 z * 2

Begin Solo
    Voice Honky-TonkPiano
    Octave 5
    Articulate 80
    Decresc ff mp 4
    Harmony 3Below
    Begin Riff
        4.d+;8e+;4d+;e+;
        4.c+;8d+;4c+;d+;
        4.b;8c+;4b;c+;
        4a;
    End
End

