// I Dont Want To See You Again
// (Peter & Gordon, 1964)

Tempo 125
Keysig F

Groove Metronome2-4
  z * 2


Groove RockBalladSusIntro
Begin AllGrooves Chord-Sus
   Voice SynthVox
   Octave 5
   Volume m
End

Begin Solo
    Voice JazzGuitar
    Octave 5
    Harmony OpenBelow
    Articulate 130
    Volume ff
    Begin Riff
        4r;a;f;a;
        4r;a;f;a;
        4r;b;g;b;
        1c+;
    End
End

Swell mp f 4

Seq 3
1         F
Seq 3
2        Dm
Seq 3
3        Gm
4        C7

Repeat  // whole song 2x
Repeat
Groove RockBallad1
Volume m

5         F
