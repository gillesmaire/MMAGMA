// Afro Blue

Tempo $(192 / 2 )  /// Fudged tempo since the main groove is in 6/8
Groove Metronome3
  z * 2
  
// The tempo is actually 192bpm in 3/4. But, since we have a
// 6/8 rhythm we multipy the time by 1.5, not 3.
Tempo $( 64 * 1.5 )

KeySig G minor

Begin Solo
     Voice JazzGuitar
     Volume f
     Articulate 80
     Octave 5
     Begin Riff
        4g;4.d+;8b;
        2.c+;
        4.b;c+;
        2g;8r;d;
        4g;4.d+;8b;
        2.c+;
        4.b;c+;
        2.g;
    End
End

Begin Solo-Harmony
   Voice Clarinet
   Octave 5
   Volume f
   HarmonyOnly OpenAbove
   DupRiff From Solo
End

/// This is the intro. Really, just the 1st 8 bars of the song

Groove Afro-Cuban

Swell p mf 8

1        Gm7
2        Am7
3         Bb      /    Am7
4        Gm7

Groove Afro-CubanIntro

5          /
6        Am7
7         Bb      /    Am7
8        Gm7

Repeat
Volume m
Groove Afro-Cuban

9        Gm7
10       Am7
11        Bb      /    Am7
12       Gm7

Groove Afro-CubanPlus
Decresc mp 4

13         /
14       Am7
15        Bb      /    Am7
16       Gm7

Groove Afro-Cuban
Volume p

17         F
18         /
19        Eb      /      F
20       Gm7

Groove Afro-CubanSus
Volume mp

21         F
22         /
23        Eb      /    F11
24       Gm7

Groove Afro-Cuban
Volume m

25         /
26       Am7
27      BbM7      /    Am7
28        G7

Groove Afro-CubanPlus
Volume mp

29       Gm7
30       Am7
31      BbM7
32       Gm7

Groove Afro-CubanSusPlus
Volume p

33         F
34         /
35        Eb      /      F
36       Gm7

Groove Afro-Cuban
Cresc m 2

37         F
38         /

RepeatEnding  2
Groove Afro-Cuban

39        Eb      /    F11

Groove Afro-CubanFill

40       Gm7

RepeatEnd

Groove Afro-CubanEnd
Decresc ppp 2

39        Eb      /    F11
40       Gm7    z!

