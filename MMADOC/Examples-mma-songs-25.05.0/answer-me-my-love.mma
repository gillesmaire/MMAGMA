// Answer Me My Love (Nat King Cole, 1954)

Tempo 64
Keysig Eb

Groove Metronome3
  z * 2
  
Groove CountryWaltzIntro

Begin AllGrooves
    Plectrum Octave 5
End

/// This only effects the intro setting. Change the arp. from
/// flute to a guitar.
Begin Arpeggio
  Voice NylonGuitar
  Octave 5
  Octave 4
End

Begin Solo
    Voice JazzGuitar
    Octave 5
    Volume f
    Harmony OpenBelow
    Articulate 110
    Begin Riff
        81e+;82b;2;
        81c+;82g;2;
        8f+;e+;d+;c+;b;c+;
        2.b;
    End
End

