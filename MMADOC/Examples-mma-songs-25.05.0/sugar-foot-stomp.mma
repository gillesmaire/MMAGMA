// Sugar Foot Stomp (Fletcher Henderson, 1925)

Tempo 140
Keysig Bb

Groove Metronome2-4
 z * 2
 
Groove RagtimeIntro

Begin Solo
     Voice $_Chord_Voice
     Octave 5
     Harmony OpenBelow
     Volume ff
     Begin Riff
         4b;8a;2f;
         4an;f;2d;
         2c;8e;g;4a;
         1f;    
     End
End

Swingmode on

Swell m f 4

1        Bb
2        Dm
3        Cm
4        F7


Repeat

Groove Ragtime
Volume m        /// not because of laziness, but we keep the
                /// volume the same ... 'cause that is how I
                /// hear tunes like this :)

5       Bb7
6       Eb7
7        Bb      /      /    Bb7
8         /

Groove RagtimePlus

9       Eb7
10        /
11       Bb      /      /   D7b5
12       G7

Groove Ragtime

13       C7
14       F7      /      /     Bb
15        /
16        /      /     C7     F7

Groove RagtimePlus

17      Bb7
18      Eb7
19       Bb
20      Bb7

Groove Ragtime

21      Eb7
22        /
23       Bb      /      /   D7b5
24       G7

Groove RagtimePlus

25       C7
26       F7      /      /     Bb
27        /
28        /    Bb7

Groove RagtimeSus

29       Eb
30        /
31        /
32        /      /      /    Ab7

Groove RagtimeSusPlus

33        /
34        /
35       Eb
36        /

Groove RagtimeSus

37      Bb7
38        /

Repeatending

39       Eb
40     Bb7+      /     Eb

RepeatEnd


Groove RagtimeEnd

39       Eb
40       Bb  

